{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      ".read": "auth != null",
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".indexOn": ["status", "hostId", "lastUpdated"],
        "id": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64"
        },
        "status": {
          ".validate": "newData.isString() && (newData.val() == 'lobby' || newData.val() == 'playing' || newData.val() == 'ended')"
        },
        "lastUpdated": {
          ".validate": "newData.isNumber()"
        },
        "players": {
          "$playerId": {
            ".validate": "newData.hasChildren(['id', 'name', 'cash'])",
            "id": {
              ".validate": "newData.isString()"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 50"
            },
            "cash": {
              ".validate": "newData.isNumber()"
            }
          }
        },
        "chat": {
          "$chatId": {
            ".validate": "newData.hasChildren(['id', 'text', 'timestamp'])",
            "text": {
              ".validate": "newData.isString() && newData.val().length <= 500"
            }
          }
        },
        "logs": {
          "$logId": {
            ".validate": "newData.hasChildren(['id', 'text', 'timestamp'])"
          }
        }
      }
    }
  }
}
